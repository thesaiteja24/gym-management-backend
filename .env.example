# Runtime
NODE_ENV="development"
PORT="9000"
PUMP_API_IMAGE_TAG="latest"

# Database Connection Strings
MASTER_URL="postgresql://postgres:password@localhost:9001/pump_dev?sslmode=disable"
REPLICA_URL="postgresql://postgres:password@localhost:9001/pump_dev?sslmode=disable"
SHADOW_URL="postgresql://postgres:password@localhost:9001/pump_shadow?sslmode=disable"

# Redis Cache Service URL
REDIS_URL="redis://localhost:9002"

# Session token hashing secret. Required in production.
SESSION_SECRET="<at-least-32-random-bytes>"

# Google login throttling
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Maximum active login sessions retained per user.
SESSION_MAX_PER_USER=10

# Postgres connection pool settings
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# OAuth Credentials
GOOGLE_WEB_CLIENT_ID="<your-google-client-id>.apps.googleusercontent.com"

# Optional push notifications
ONESIGNAL_APP_ID="<your-onesignal-app-id>"
ONESIGNAL_API_KEY="<your-onesignal-rest-api-key>"
ONESIGNAL_ANDROID_CHANNEL_ID="<your-onesignal-android-channel-id>"

# Deployment / routing
LOG_LEVEL="info"
CORS_ORIGINS="http://localhost:9000"
CADDY_EMAIL="you@example.com"
PUMP_DOMAIN="pump.thesaiteja.dev"
