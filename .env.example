# Database Connection Strings (Neon, Supabase, or standard PostgreSQL)
MASTER_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require"
REPLICA_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require"
SHADOW_URL="postgresql://<user>:<password>@<host>:<port>/<shadow_dbname>?sslmode=require"

# Redis Cache Service URL
REDIS_URL="redis://<user>:<password>@<host>:<port>"

# OAuth Credentials
GOOGLE_WEB_CLIENT_ID="<your-google-client-id>.apps.googleusercontent.com"
