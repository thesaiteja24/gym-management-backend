{
  "name": "gym-management-backend",
  "version": "1.0.0",
  "description": "The backend for gym management application",
  "homepage": "https://github.com/thesaiteja24/gym-management-backend#readme",
  "bugs": {
    "url": "https://github.com/thesaiteja24/gym-management-backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesaiteja24/gym-management-backend.git"
  },
  "license": "ISC",
  "author": "sai teja",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon",
    "build": "node --max-old-space-size=2048 ./node_modules/typescript/bin/tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "clean": "rm -rf dist",
    "reset": "rm -rf node_modules dist && npm install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.911.0",
    "@onesignal/node-onesignal": "^5.5.0",
    "@prisma/client": "^6.17.1",
    "@prisma/extension-accelerate": "^2.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "openai": "^6.18.0",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.9",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "prisma": "^6.17.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0"
  }
}
