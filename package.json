{
  "name": "pump-fastify",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run dist/src/server.js",
    "env:sync": "bun run scripts/env-sync.ts",
    "habits:backfill-internal": "bun run scripts/backfill-internal-habit-logs.ts",
    "habits:seed": "bun run scripts/seed-habits.ts",
    "reminders:dispatch": "bun run src/workers/habit-reminder.scheduler.ts",
    "reminders:health": "bun run src/workers/habit-reminder.health.ts",
    "reminders:replay-failed": "bun run src/workers/habit-reminder.replay-failed.ts",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "bun run scripts/run-tests.ts",
    "test:watch": "bun test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "validate": "bun run lint && bun run typecheck && bun run test",
    "setup": "bun run scripts/setup.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^6.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/redis": "^7.2.0",
    "@fastify/swagger": "^9.7.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/fastify-api-reference": "^1.57.5",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "google-auth-library": "^10.6.2",
    "nanoid": "^5.1.11",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^25.7.0",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.14",
    "eslint": "^10.3.0",
    "eslint-plugin-check-file": "latest",
    "husky": "latest",
    "lint-staged": "^17.0.4",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.13"
  }
