generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String               @id @default(uuid(7))
  firstName               String
  lastName                String
  dateOfBirth             DateTime?            @db.Date
  height                  Decimal?             @db.Decimal(6, 2)
  weight                  Decimal?             @db.Decimal(6, 2)
  profilePicUrl           String
  role                    UserRole             @default(member)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  preferredLengthUnit     LengthUnits          @default(cm)
  preferredWeightUnit     WeightUnits          @default(kg)
  gender                  Gender?
  email                   String               @unique
  googleId                String               @unique
  privacyPolicyAcceptedAt DateTime
  privacyPolicyVersion    String               @default("1.0")
  followersCount          Int                  @default(0)
  followingCount          Int                  @default(0)
  workoutsCount           Int                  @default(0)
  isPro                   Boolean              @default(false)
  proExpirationDate       DateTime?
  proSubscriptionId       String?
  proSubscriptionType     String?
  following               Follow[]             @relation("UserFollowing")
  followers               Follow[]             @relation("UserFollowers")
  gymsOwned               Gym[]                @relation("GymOwner")
  habits                  Habit[]
  memberships             Membership[]
  programs                Program[]
  fitnessProfile          UserFitnessProfile?
  measurements            UserMeasurement[]
  nutritionPlan           UserNutritionPlan?
  userPrograms            UserProgram[]
  workoutComments         WorkoutComment[]
  workoutCommentLikes     WorkoutCommentLike[]
  workoutLikes            WorkoutLike[]
  workoutLogs             WorkoutLog[]
  workoutTemplates        WorkoutTemplate[]

  @@index([role])
  @@index([firstName])
  @@index([lastName])
}

model UserFitnessProfile {
  id                 String          @id @default(uuid(7))
  userId             String          @unique
  fitnessGoal        FitnessGoal?
  fitnessLevel       FitnessLevel?
  injuries           String?
  availableEquipment EquipmentType[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  targetDate         DateTime?       @db.Date
  targetWeight       Decimal?        @db.Decimal(6, 2)
  activityLevel      ActivityLevel?
  targetBodyFat      Decimal?        @db.Decimal(5, 2)
  targetType         TargetType?
  weeklyWeightChange Decimal?        @db.Decimal(6, 2)
  user               User            @relation(fields: [userId], references: [id])
}

model UserNutritionPlan {
  id               String   @id @default(uuid(7))
  userId           String   @unique
  caloriesTarget   Int?
  proteinTarget    Int?
  calculatedTDEE   Int?
  deficitOrSurplus Int?
  startDate        DateTime @db.Date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  carbsTarget      Int?
  fatsTarget       Int?
  user             User     @relation(fields: [userId], references: [id])
}

model UserMeasurement {
  id              String   @id @default(uuid(7))
  userId          String
  date            DateTime
  weight          Decimal? @db.Decimal(6, 2)
  waist           Decimal? @db.Decimal(6, 2)
  bodyFat         Decimal? @db.Decimal(5, 2)
  leanBodyMass    Decimal? @db.Decimal(6, 2)
  neck            Decimal? @db.Decimal(6, 2)
  shoulders       Decimal? @db.Decimal(6, 2)
  chest           Decimal? @db.Decimal(6, 2)
  abdomen         Decimal? @db.Decimal(6, 2)
  hips            Decimal? @db.Decimal(6, 2)
  leftBicep       Decimal? @db.Decimal(6, 2)
  rightBicep      Decimal? @db.Decimal(6, 2)
  leftForearm     Decimal? @db.Decimal(6, 2)
  rightForearm    Decimal? @db.Decimal(6, 2)
  leftThigh       Decimal? @db.Decimal(6, 2)
  rightThigh      Decimal? @db.Decimal(6, 2)
  leftCalf        Decimal? @db.Decimal(6, 2)
  rightCalf       Decimal? @db.Decimal(6, 2)
  notes           String?
  progressPicUrls String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Gym {
  id          String       @id @default(uuid(7))
  name        String
  ownerId     String
  description String?
  timings     Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation("GymOwner", fields: [ownerId], references: [id])
  memberships Membership[]

  @@index([ownerId])
  @@index([name])
}

model WorkoutLog {
  id              String                    @id @default(uuid(7))
  userId          String
  title           String?
  startTime       DateTime?
  endTime         DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  editedAt        DateTime?
  isEdited        Boolean                   @default(false)
  clientId        String?                   @unique
  deletedAt       DateTime?
  visibility      WorkoutLogVisibility      @default(public)
  commentsCount   Int                       @default(0)
  likesCount      Int                       @default(0)
  shareId         String?                   @unique
  userProgramDay  UserProgramDay?
  workoutComments WorkoutComment[]
  workoutLikes    WorkoutLike[]
  user            User                      @relation(fields: [userId], references: [id])
  exercises       WorkoutLogExercise[]
  exerciseGroups  WorkoutLogExerciseGroup[]

  @@index([userId, deletedAt, createdAt])
  @@index([visibility, deletedAt, userId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, deletedAt, startTime])
}

/// *
/// * ───────────────── WORKOUT EXERCISE GROUP ─────────────────
model WorkoutLogExerciseGroup {
  id                  String               @id @default(uuid(7))
  workoutId           String
  groupIndex          Int
  restSeconds         Int?
  note                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  groupType           ExerciseGroupType
  workoutLogExercises WorkoutLogExercise[]
  workout             WorkoutLog           @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId, groupIndex])
}

model WorkoutLogExercise {
  id              String                   @id @default(uuid(7))
  workoutId       String
  exerciseId      String
  exerciseIndex   Int
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  exerciseGroupId String?
  exerciseGroup   WorkoutLogExerciseGroup? @relation(fields: [exerciseGroupId], references: [id])
  exercise        Exercise                 @relation(fields: [exerciseId], references: [id])
  workout         WorkoutLog               @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sets            WorkoutLogExerciseSet[]

  @@index([workoutId, exerciseIndex])
  @@index([exerciseId])
  @@index([workoutId])
}

model WorkoutLogExerciseSet {
  id                String             @id @default(uuid(7))
  workoutExerciseId String
  setIndex          Int
  weight            Decimal?           @db.Decimal(8, 3)
  reps              Int?
  rpe               Int?
  durationSeconds   Int?
  note              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  restSeconds       Int?
  setType           SetType            @default(working)
  workoutExercise   WorkoutLogExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId, setIndex])
  @@index([workoutExerciseId])
}

model Exercise {
  id                   String                    @id @default(uuid(7))
  title                String
  instructions         String?
  thumbnailUrl         String?
  videoUrl             String?
  primaryMuscleGroupId String?
  equipmentId          String?
  exerciseType         ExerciseType              @default(weighted)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  equipment            Equipment?                @relation(fields: [equipmentId], references: [id])
  primaryMuscleGroup   MuscleGroup?              @relation("PrimaryMuscleGroup", fields: [primaryMuscleGroupId], references: [id])
  otherMuscleGroups    ExerciseMuscleGroup[]
  workoutLogExercises  WorkoutLogExercise[]
  templateExercises    WorkoutTemplateExercise[]

  @@index([title])
  @@index([primaryMuscleGroupId])
  @@index([equipmentId])
}

model Equipment {
  id           String         @id @default(uuid(7))
  title        String         @unique
  thumbnailUrl String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  type         EquipmentType?
  exercises    Exercise[]
}

model MuscleGroup {
  id               String                @id @default(uuid(7))
  title            String                @unique
  thumbnailUrl     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tags             String[]
  primaryExercises Exercise[]            @relation("PrimaryMuscleGroup")
  exercises        ExerciseMuscleGroup[]
}

model ExerciseMuscleGroup {
  id            String      @id @default(uuid(7))
  exerciseId    String
  muscleGroupId String
  exercise      Exercise    @relation(fields: [exerciseId], references: [id])
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id])

  @@unique([exerciseId, muscleGroupId])
  @@index([muscleGroupId])
}

model Membership {
  id             String   @id @default(uuid(7))
  gymId          String
  userId         String
  membershipType String?
  joinedAt       DateTime @default(now())
  status         String   @default("active")
  gym            Gym      @relation(fields: [gymId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@unique([gymId, userId])
  @@index([userId])
}

model WorkoutTemplate {
  id             String                         @id @default(uuid(7))
  userId         String
  title          String
  notes          String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  deletedAt      DateTime?
  shareId        String?                        @unique
  authorName     String?
  sourceShareId  String?
  programDays    ProgramDay[]
  user           User                           @relation(fields: [userId], references: [id])
  exercises      WorkoutTemplateExercise[]
  exerciseGroups WorkoutTemplateExerciseGroup[]

  @@index([userId])
}

model WorkoutTemplateExerciseGroup {
  id          String                    @id @default(uuid(7))
  templateId  String
  groupType   ExerciseGroupType
  groupIndex  Int
  restSeconds Int?
  exercises   WorkoutTemplateExercise[]
  template    WorkoutTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, groupIndex])
}

model WorkoutTemplateExercise {
  id              String                        @id @default(uuid(7))
  templateId      String
  exerciseId      String
  exerciseIndex   Int
  exerciseGroupId String?
  exerciseGroup   WorkoutTemplateExerciseGroup? @relation(fields: [exerciseGroupId], references: [id])
  exercise        Exercise                      @relation(fields: [exerciseId], references: [id])
  template        WorkoutTemplate               @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sets            WorkoutTemplateSet[]

  @@index([templateId, exerciseIndex])
}

model WorkoutTemplateSet {
  id                 String                  @id @default(uuid(7))
  templateExerciseId String
  setIndex           Int
  setType            SetType                 @default(working)
  weight             Decimal?                @db.Decimal(8, 3)
  reps               Int?
  rpe                Int?
  durationSeconds    Int?
  restSeconds        Int?
  note               String?
  autoProgress       Boolean                 @default(false)
  maxReps            Int?
  minReps            Int?
  progressionStep    Decimal?
  progressionType    ProgressionType?
  templateExercise   WorkoutTemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)

  @@index([templateExerciseId, setIndex])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model WorkoutLike {
  userId    String
  workoutId String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout   WorkoutLog @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@id([userId, workoutId])
  @@index([workoutId])
}

model WorkoutComment {
  id                  String               @id @default(uuid(7))
  workoutId           String
  userId              String
  content             String
  parentId            String?
  likesCount          Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  parent              WorkoutComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies             WorkoutComment[]     @relation("CommentReplies")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout             WorkoutLog           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutCommentLikes WorkoutCommentLike[]

  @@index([workoutId, parentId])
  @@index([workoutId, createdAt])
  @@index([parentId])
  @@index([userId])
}

model WorkoutCommentLike {
  userId    String
  commentId String
  createdAt DateTime       @default(now())
  comment   WorkoutComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

model RevenueCatEvent {
  id             String   @id
  type           String
  appUserId      String
  eventTimestamp DateTime
  processedAt    DateTime @default(now())

  @@index([appUserId])
}

model Habit {
  id               String            @id @default(uuid(7))
  userId           String
  title            String
  colorScheme      String
  trackingType     HabitTrackingType
  targetValue      Decimal?          @db.Decimal(10, 2)
  unit             String?
  footerType       HabitFooterType   @default(weeklyStreak)
  source           HabitSource       @default(manual)
  internalMetricId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs             HabitLog[]

  @@index([userId])
}

model HabitLog {
  id      String   @id @default(uuid(7))
  habitId String
  date    DateTime @db.Date
  value   Decimal  @db.Decimal(10, 2)
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId, date])
}

model Program {
  id              String        @id @default(uuid(7))
  clientId        String        @unique
  title           String
  description     String?
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  durationOptions Int[]
  experienceLevel FitnessLevel
  user            User?         @relation(fields: [createdBy], references: [id])
  weeks           ProgramWeek[]
  userPrograms    UserProgram[]

  @@index([createdBy])
}

model ProgramWeek {
  id        String       @id @default(uuid(7))
  name      String
  weekIndex Int
  programId String
  days      ProgramDay[]
  program   Program      @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, weekIndex])
  @@index([programId])
}

model ProgramDay {
  id         String           @id @default(uuid(7))
  name       String
  weekId     String
  dayIndex   Int
  templateId String?
  isRestDay  Boolean          @default(false)
  template   WorkoutTemplate? @relation(fields: [templateId], references: [id])
  week       ProgramWeek      @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([weekId, dayIndex])
  @@index([weekId])
  @@index([templateId])
}

model UserProgram {
  id            String               @id @default(uuid(7))
  userId        String
  programId     String
  startDate     DateTime             @db.Date
  status        UserProgramStatus    @default(active)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  durationWeeks Int
  program       Program              @relation(fields: [programId], references: [id])
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress      UserProgramProgress?
  weeks         UserProgramWeek[]

  @@index([userId])
  @@index([programId])
  @@index([userId, status])
}

model UserProgramWeek {
  id            String           @id @default(uuid(7))
  userProgramId String
  weekIndex     Int
  days          UserProgramDay[]
  userProgram   UserProgram      @relation(fields: [userProgramId], references: [id], onDelete: Cascade)

  @@unique([userProgramId, weekIndex])
  @@index([userProgramId])
}

model UserProgramDay {
  id                 String                   @id @default(uuid(7))
  userProgramWeekId  String
  name               String
  dayIndex           Int
  isRestDay          Boolean
  templateSnapshotId String?
  completed          Boolean                  @default(false)
  completedAt        DateTime?
  workoutLogId       String?                  @unique
  templateSnapshot   WorkoutTemplateSnapshot? @relation(fields: [templateSnapshotId], references: [id])
  week               UserProgramWeek          @relation(fields: [userProgramWeekId], references: [id], onDelete: Cascade)
  workoutLog         WorkoutLog?              @relation(fields: [workoutLogId], references: [id])

  @@unique([userProgramWeekId, dayIndex])
  @@index([userProgramWeekId])
}

model UserProgramProgress {
  id            String      @id @default(uuid(7))
  userProgramId String      @unique
  currentWeek   Int         @default(0)
  currentDay    Int         @default(0)
  updatedAt     DateTime    @updatedAt
  userProgram   UserProgram @relation(fields: [userProgramId], references: [id], onDelete: Cascade)
}

model WorkoutTemplateSnapshot {
  id                 String           @id @default(uuid(7))
  originalTemplateId String?
  title              String
  notes              String?
  exercises          Json
  createdAt          DateTime         @default(now())
  userProgramDays    UserProgramDay[]

  @@index([originalTemplateId])
}

enum UserRole {
  systemAdmin
  gymAdmin
  trainer
  member
}

enum Gender {
  male
  female
  other
}

enum ExerciseType {
  repsOnly
  assisted
  weighted
  durationOnly
}

enum SetType {
  warmup
  working
  dropSet
  failureSet
}

enum ExerciseGroupType {
  superSet
  giantSet
}

enum WeightUnits {
  kg
  lbs
}

enum LengthUnits {
  cm
  inches
}

enum FitnessGoal {
  loseWeight
  gainMuscle
  improveEndurance
  improveFlexibility
  improveStrength
  improveOverallFitness
}

enum FitnessLevel {
  beginner
  intermediate
  advanced
}

enum ActivityLevel {
  sedentary
  lightlyActive
  moderatelyActive
  veryActive
  athlete
}

enum TargetType {
  weight
  bodyFat
}

enum EquipmentType {
  bodyweight
  dumbbells
  barbells
  kettlebells
  resistanceBands
  machines
  other
}

enum WorkoutLogVisibility {
  public
  private
}

enum HabitTrackingType {
  streak
  quantity
}

enum HabitFooterType {
  weeklyStreak
  weeklyCount
}

enum HabitSource {
  manual
  internal
}

enum UserProgramStatus {
  active
  completed
  paused
  cancelled
}

enum ProgressionType {
  linear
  doubleProgression
}

enum ProgramWeekType {
  base
  progression
  deload
}
